package org.example;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class CalculatorPopulationTest {

    @Test
    public void mustCalculatePercentageCorrectly() {

        CalculatorPopulation calc = new CalculatorPopulation();
        double populationCity = 50.0;
        double populationTotal = 100.0;


        double result = calc.calculatePercentage(populationCity, populationTotal);



        assertEquals( 50.0, result, " 50 of 100 must be 50%");

    }
}

