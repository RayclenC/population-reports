package org.example;
import org.exampleJv.calculatorPopulation;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;


public class CalculatorTest {
       @Test
       void
    mustCalculatePercentageCorrectly() {

           calculatorPopulation calc = new calculatorPopulation();

           double populationCity = 2.85;
           double populationTotal = 69.93;

           double result = calc.calculatePercentage(populationCity, populationTotal);

           assertEquals (4.07, result, 0.001, "3 of 70 must be 4.08");
       }
}

